{
  "Velocity service": {
    "prefix": "velservice",
    "body": [
      "local Framework = _framework",
      "",
      "local ${1:ProfileService} = Framework.CreateService({",
      "    Name = \"${1:ProfileService}\",",
      "    Client = {},",
      "})",
      "",
      "function ${1:ProfileService}:Init()",
      "    $0",
      "end",
      "",
      "function ${1:ProfileService}:Start()",
      "end",
      "",
      "return ${1:ProfileService}"
    ],
    "description": "Create a server service with Init and Start methods."
  },
  "Velocity client controller": {
    "prefix": "velcontroller",
    "body": [
      "local Framework = _framework",
      "",
      "local ${1:MainController} = Framework.CreateController({",
      "    Name = \"${1:MainController}\",",
      "})",
      "",
      "function ${1:MainController}:Init()",
      "    $0",
      "end",
      "",
      "function ${1:MainController}:Start()",
      "end",
      "",
      "return ${1:MainController}"
    ],
    "description": "Create a client side controller with Init and Start methods."
  },
  "Velocity server bootstrap": {
    "prefix": "velstart",
    "body": [
      "local Framework = _framework",
      "local servicesFolder = script.Parent:WaitForChild(\"Services\")",
      "",
      "for _, serviceModule in ipairs(servicesFolder:GetChildren()) do",
      "    if serviceModule:IsA(\"ModuleScript\") then",
      "        require(serviceModule)",
      "    end",
      "end",
      "",
      "Framework.Start()"
    ],
    "description": "Require server services, then run their methods."
  },
  "Velocity client bootstrap": {
    "prefix": "velclientstart",
    "body": [
      "local Framework = _framework",
      "local controllersFolder = script.Parent:WaitForChild(\"Controllers\")",
      "",
      "for _, controllerModule in ipairs(controllersFolder:GetChildren()) do",
      "    if controllerModule:IsA(\"ModuleScript\") then",
      "        require(controllerModule)",
      "    end",
      "end",
      "",
      "Framework.Start()"
    ],
    "description": "Require client controllers, then run their methods."
  },
  "Get Velocity service": {
    "prefix": "velget",
    "body": [
      "local ${1:ProfileService} = _framework.GetService(\"${2:ProfileService}\")"
    ],
    "description": "Get a local server service or its client remote proxy."
  },
  "Get Velocity controller": {
    "prefix": "velcontrollerget",
    "body": [
      "local ${1:MainController} = _framework.GetController(\"${2:MainController}\")"
    ],
    "description": "Get a client controller."
  },
  "Velocity client method": {
    "prefix": "velmethod",
    "body": [
      "${1:GetProfile} = function(self, player)",
      "    $0",
      "end,"
    ],
    "description": "Add a client callable server method inside a service Client table."
  },
  "Velocity remote signal endpoint": {
    "prefix": "velevent",
    "body": [
      "${1:ProfileUpdated} = _framework.CreateRemoteSignal(),"
    ],
    "description": "Add a `server to client` or `client to server` event inside a service Client table."
  },
  "Call Velocity service method": {
    "prefix": "velcall",
    "body": [
      "${1:ProfileService}:${2:GetProfile}(${3})"
    ],
    "description": "Get a server method exposed in the service Client table."
  },
  "Connect Velocity remote signal on client": {
    "prefix": "velremoteconnect",
    "body": [
      "${1:ProfileService}.${2:ProfileUpdated}:Connect(function(${3:profile})",
      "    $0",
      "end)"
    ],
    "description": "Listen for a remote signal from a client script."
  },
  "Connect Velocity remote signal on server": {
    "prefix": "velremoteonserver",
    "body": [
      "${1:ProfileService}.Client.${2:Report}:Connect(function(player, ${3:message})",
      "    $0",
      "end)"
    ],
    "description": "Listen for a client remote signal, the sender Player is passed first."
  },
  "Fire Velocity remote signal to server": {
    "prefix": "velremotetoserver",
    "body": [
      "${1:ProfileService}.${2:Report}:FireServer(${3:message})"
    ],
    "description": "Send a remote signal from a client to the server."
  },
  "Fire Velocity remote signal to client": {
    "prefix": "velremotetoclient",
    "body": [
      "${1:ProfileService}.Client.${2:ProfileUpdated}:Fire(${3:player}, ${4:profile})"
    ],
    "description": "Send a remote signal from the server to one client."
  },
  "Broadcast Velocity remote signal": {
    "prefix": "velremotebroadcast",
    "body": [
      "${1:ProfileService}.Client.${2:ProfileUpdated}:FireAll(${3:profile})"
    ],
    "description": "Send a remote signal from the server to all clients."
  },
  "Create Velocity signal": {
    "prefix": "velsignal",
    "body": [
      "local ${1:Changed} = _framework.CreateSignal()"
    ],
    "description": "Create a local Velocity signal."
  },
  "Connect Velocity signal": {
    "prefix": "velconnect",
    "body": [
      "local ${1:connection} = ${2:changed}:Connect(function(${3:value})",
      "    $0",
      "end)"
    ],
    "description": "Connect a callback to a local Velocity signal."
  },
  "Connect once to Velocity signal": {
    "prefix": "velonce",
    "body": [
      "${1:changed}:Once(function(${2:value})",
      "    $0",
      "end)"
    ],
    "description": "Run a callback once when a local signal fires."
  },
  "Wait for Velocity signal": {
    "prefix": "velwait",
    "body": [
      "local ${1:value} = ${2:changed}:Wait()"
    ],
    "description": "Wait for a local signal and capture its arguments."
  },
  "Fire Velocity signal": {
    "prefix": "velfire",
    "body": [
      "${1:changed}:Fire(${2:value})"
    ],
    "description": "Fire a local Velocity signal."
  },
  "Disconnect Velocity signal connection": {
    "prefix": "veldisconnect",
    "body": [
      "${1:connection}:Disconnect()"
    ],
    "description": "Disconnect a local Velocity signal connection."
  }
}